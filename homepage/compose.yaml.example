services:
  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage

    ports:
      - "3000:3000"

    environment:
      HOMEPAGE_ALLOWED_HOSTS: <PI-IP>:3000
      HOMEPAGE_VAR_PIHOLE_PASSWORD: ${PIHOLE_PASSWORD}

    extra_hosts:
      - "host.docker.internal:host-gateway"

    volumes:
      - ./config:/app/config

    restart: unless-stopped