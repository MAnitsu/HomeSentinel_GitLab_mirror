# HomeSentinel network configuration

# Local LAN subnet to scan.
# Replace with the subnet used by the deployment.
HOMESENTINEL_NETWORK=192.168.1.0/24

# Path where the latest scan result is stored.
HOMESENTINEL_NETWORK_SCAN_FILE=/var/lib/homesentinel/network-scan.json

# Optional friendly labels for devices whose hostnames
# cannot be discovered automatically by Nmap.
#
# Multiple entries can be separated with commas.
#
# Example:
# HOMESENTINEL_DEVICE_LABELS=192.168.1.1:Router,192.168.1.10:NAS
HOMESENTINEL_DEVICE_LABELS=
